# Flask — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# PostgreSQL
DATABASE_URL=postgresql://leo:leo@localhost:5432/leo_tickets

# Google OAuth (create at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URI=http://localhost:5000/google/auth
BASE_URI=http://localhost:5000/

# RBAC bootstrap — your Google account gets superadmin on first login
SUPERADMIN_EMAIL=

# REST API keys — generate unique random strings; never commit real values
SCANNER_API_KEY=
ADMIN_API_KEY=

# Scanner deduplication window (seconds)
SCAN_DEDUP_SECONDS=60

# Local dev only — copy data/emails.example.txt → data/emails.txt
# and data/admin.example.txt → data/admin.txt with real addresses.
